{% extends "layouts/base.njk" %}

{% block content %}
  <div class="page-header">
    <h1>Edit Post</h1>
  </div>

  <form method="POST" action="/posts/{{ post.id }}?_method=PATCH" class="form">
    <div class="form__group">
      <label for="title">Title</label>
      <input type="text" id="title" name="title"
             value="{{ post.title }}" class="form__input" autofocus>
    </div>
    <div class="form__group">
      <label for="body">Body</label>
      <textarea id="body" name="body" rows="12"
                class="form__input form__textarea">{{ post.body }}</textarea>
    </div>

    {% set selectedCategoryId = post.categoryId %}
    {% include "partials/_category_select.njk" %}

    <div class="form__actions">
      <button type="submit" class="btn btn--primary">Update Post</button>
      <a href="/posts/{{ post.id }}" class="btn btn--ghost">Cancel</a>
    </div>
  </form>
{% endblock %}