{% extends "layouts/base.njk" %}

{% block content %}
  <div class="page-header">
    <h1>New Post</h1>
  </div>

  <form method="POST" action="/posts" class="form">
    <div class="form__group">
      <label for="title">Title</label>
      <input type="text" id="title" name="title"
             value="{{ values.title if values else '' }}"
             class="form__input" autofocus>
    </div>
    <div class="form__group">
      <label for="body">Body</label>
      <textarea id="body" name="body" rows="12"
                class="form__input form__textarea">{{ values.body if values else '' }}</textarea>
    </div>

    {% set selectedCategoryId = values.categoryId | int if values else null %}
    {% include "partials/_category_select.njk" %}

    <div class="form__actions">
      <button type="submit" class="btn btn--primary">Create Post</button>
      <a href="/posts" class="btn btn--ghost">Cancel</a>
    </div>
  </form>
{% endblock %}