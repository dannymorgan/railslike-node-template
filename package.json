{
  "name": "railslike-node-template",
  "version": "1.0.0",
  "description": "An attempt at making a node stack that is intuitively comfortable for users of Rails",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "author": "Danny Morgan",
  "license": "ISC",
  "dependencies": {
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "method-override": "^3.0.0",
    "nunjucks": "^3.2.4",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}